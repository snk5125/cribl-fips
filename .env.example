# Copy to .env — docker compose reads it automatically (git-ignored).
# Every knob is also a plain env var for docker run --env-file / -e.

# --- host port mappings (compose-level; container-internal ports are fixed) --
CRIBL_UI_PORT=9000        # UI / API
CRIBL_HTTP_PORT=8080      # http_raw NDJSON in
CRIBL_OTLP_PORT=4318      # OTLP/HTTP in

# --- FIPS / topology ---------------------------------------------------------
# CRIBL_FIPS=1 is the image default (fail-closed). FIPS requires
# CRIBL_DIST_MODE=master|worker plus an RBAC-entitled license.
#CRIBL_FIPS=0
#CRIBL_DIST_MODE=master
#CRIBL_LICENSE=
#CRIBL_DIST_MASTER_URL=tcp://criblmaster@cribl-leader:4200

# --- auth --------------------------------------------------------------------
# >= 8 chars, >= 3 classes; uppercase not counting the first character,
# digits not counting the last (entrypoint fails fast otherwise)
#CRIBL_ADMIN_PASSWORD=

# --- remote config tree (pipelines / routes / inputs / outputs) --------------
# Overlay order: baked image defaults -> remote fetch -> /opt/cribl-seed
# mount. Set at most ONE of GIT_URL / URL. Fetch failure aborts boot.
# Git repo (https or ssh):
#CRIBL_CONFIG_GIT_URL=https://github.com/you/cribl-config.git
#CRIBL_CONFIG_GIT_REF=main
# ...or a .tgz over https (presigned S3 URLs work), optionally pinned:
#CRIBL_CONFIG_URL=https://bucket.s3.amazonaws.com/cribl-config.tgz?X-Amz-...
#CRIBL_CONFIG_SHA256=
# Subdirectory inside the repo/tarball holding the local/cribl tree:
#CRIBL_CONFIG_PATH=stream/aggregator
